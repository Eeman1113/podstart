# Supabase project credentials. Both are safe to ship in a public static bundle:
# the anon key only grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Repo name when hosting on <user>.github.io/<repo>. Empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=/podstart

# Optional: a TURN server for peers that cannot connect directly (strict mobile
# carrier NAT). Talkback falls back to STUN-only without it; recording is
# unaffected because every track is captured locally.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Google Drive archiving. Optional: without it the Drive panel explains how to
# set it up and everything else works unchanged.
#
# Create an OAuth 2.0 Client ID of type "Web application" at
# console.cloud.google.com, enable the Google Drive API, and add your site's
# origin (e.g. https://eeman1113.github.io) under Authorized JavaScript origins.
# There is no client secret: this is a browser app and the token is issued
# directly to the page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
